// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth Models

// UserStatus: pending_approval | invited | active | inactive | deactivated | rejected | expired
// UserSource:  signup | admin | ticket | ad

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String    @unique
  password        String
  phone           String?
  reasonForAccess String?
  employeeId      String?
  businessUnit    String?
  dateOfBirth     String?
  profilePicture  String?
  name            String
  role            String    @default("user")
  requestedRole   String?
  // lifecycle status
  status          String    @default("pending_approval")
  source          String    @default("signup")        // signup | admin | ticket | ad
  // approval
  reviewedBy      Int?
  reviewedAt      DateTime?
  adminNotes      String?
  // invitation
  invitationToken  String?
  invitationExpiry DateTime?
  // password management
  mustResetPassword       Boolean   @default(false)
  otp                     String?
  otpExpiresAt            DateTime?
  otpIsUsed               Boolean   @default(false)
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  passwordChangedAt       DateTime?
  // access control
  isActive                Boolean   @default(false)
  accessFromDate          DateTime?
  accessToDate            DateTime?
  firstActivationDate     DateTime?
  lastDeactivationDate    DateTime?
  // tracking
  lastActivityAt          DateTime?
  // captain fields
  captainProfileUpdated Boolean  @default(false)
  application              String?
  applicationLead          String?
  // timestamps
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model UserChangeLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  changeType    String   // field_update | role_change | access_approved | access_created | password_reset | activation | deactivation | rejection
  fieldName     String?
  previousValue String?
  newValue      String?
  changedBy     Int
  changedByName String
  reasonCode    String?
  reasonNotes   String?
  createdAt     DateTime @default(now())
}

model CaptainProfile {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  application          String
  captainRole       String?
  slaWorkingCalendar   String?
  slaExceptionCalendar String?
  leadCaptain       String?
  applicationManager   String?
  isPocLead            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CaptainRole {
  id          Int      @id @default(autoincrement())
  application String
  roleName    String
  description String?
  createdAt   DateTime @default(now())
}

model LoginLog {
  id         Int       @id @default(autoincrement())
  userId     Int
  loginTime  DateTime  @default(now())
  logoutTime DateTime?
  ipAddress  String?
  device     String?
  userAgent  String?
}

// ADMIN API Models

model AdminHeader {
  id          Int      @id @default(autoincrement())
  ticketType  String
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  app         String
  order       Int
}

model AdminServiceRequest {
  id                 Int      @id @default(autoincrement())
  number             String   @unique
  client             String?
  caller             String
  callerPhone        String?
  callerEmail        String?
  callerLocation     String?
  callerDepartment   String?
  businessCategory   String?
  serviceLine        String?
  application        String?
  applicationCategory    String?
  applicationSubCategory String?
  shortDescription   String?
  description        String?
  impact             String?
  urgency            String?
  priority           String?
  status             String   @default("new")
  assignmentGroup    String?
  primaryResource    String?
  secondaryResources String?
  createdBy          String
  isRecurring           Boolean   @default(false)
  isReleaseManagement   Boolean   @default(false)
  eta                   DateTime?
  notes                 String?
  relatedRecords     String?
  attachments        String?
  followers          String?
  internalFollowers  String?
  draftExpiresAt     DateTime?
  clientPrimaryContact   String?
  billingCode            String?
  approvedEstimatesHours Float?
  estimatesDetails       String?
  analysisSummary    String?
  ticketSource       String?
  resolvedAt         DateTime?
  resolvedBy         String?
  closedAt           DateTime?
  closedBy           String?
  reopenedAt         DateTime?
  reopenedBy         String?
  approvedAt         DateTime?
  approvedBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  comments           AdminServiceRequestComment[]
  timeEntries        AdminServiceRequestTimeEntry[]
  resolutions        AdminServiceRequestResolution[]
  activities         AdminServiceRequestActivity[]
}

model AdminServiceRequestComment {
  id                  Int      @id @default(autoincrement())
  serviceRequestId    Int
  serviceRequest      AdminServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  subject             String
  message             String
  isInternal          Boolean  @default(false)
  isSelfNote          Boolean  @default(false)
  notifyAssigneesOnly Boolean  @default(false)
  status              String?
  attachments         String?
  createdBy           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AdminServiceRequestTimeEntry {
  id               Int      @id @default(autoincrement())
  serviceRequestId Int
  serviceRequest   AdminServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  date             String
  hours            Int
  minutes          Int
  billingCode      String?
  activityTask     String?
  externalComment  String?
  internalComment  String?
  isNonBillable    Boolean  @default(false)
  attachments      String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminServiceRequestResolution {
  id                   Int      @id @default(autoincrement())
  serviceRequestId     Int
  serviceRequest       AdminServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  application          String?
  category             String?
  subCategory          String?
  customerConfirmation Boolean  @default(false)
  isRecurring          Boolean  @default(false)
  rootCauseIdentified  Boolean  @default(false)
  rootCause            String?
  resolutionCode       String
  resolution           String
  internalNote         String?
  attachments          String?
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AdminServiceRequestActivity {
  id               Int      @id @default(autoincrement())
  serviceRequestId Int
  serviceRequest   AdminServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  activityType     String
  description      String
  previousValue    String?
  newValue         String?
  performedBy      String
  createdAt        DateTime @default(now())
}

// USER API Models

model UserDashboard {
  id   String @id @default(cuid())
  name String
  key  String
  path String
  app  String
}

model UserHeader {
  id   String @id @default(cuid())
  name String
  key  String
  path String
  app  String
}

model UserSideNav {
  id   String @id @default(cuid())
  name String
  key  String
  path String
  app  String
}


